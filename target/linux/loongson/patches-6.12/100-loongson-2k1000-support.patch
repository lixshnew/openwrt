+/* ADC dual mode -------------------------------------------------------------*/
+#define ADC_Mode_Independent                       ((unsigned int)0x00000000)
+#define ADC_Mode_RegInjecSimult                    ((unsigned int)0x00010000)
+#define ADC_Mode_RegSimult_AlterTrig               ((unsigned int)0x00020000)
