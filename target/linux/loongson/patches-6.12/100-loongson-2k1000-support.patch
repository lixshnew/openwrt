+	status = "okay";
+};
+
+&sdio1 {
+	//cd-gpios = <&io_expander_a 4 GPIO_ACTIVE_LOW>;
+	status = "okay";
+};
+
+&i2s {
+	status = "okay";
+};
+
+&audio {
+	status = "okay";
+};
+
+&sound {
