+#define ADC_ExternalTrigConv_T5_CC3                ((unsigned int)0x000C0000)
+
+#define IS_ADC_EXT_TRIG(REGTRIG) (((REGTRIG) == ADC_ExternalTrigConv_T1_CC1) || \
